{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sixdrop",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 让 Worker 先跑：www/http 的 301、/about 和 /guide 的漂亮 URL 都在 Worker 里处理
    "run_worker_first": true,
    // 关掉 Assets 的自动 .html / 尾斜杠改写，避免和 Worker 的路由互相 307
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DROPS", "class_name": "Drop" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Drop"] },
    { "tag": "v3", "new_sqlite_classes": ["Lobby"] }
  ],
  "observability": { "enabled": true },
  "workers_dev": true,

  // 自定义域名：zone 已激活，deploy 时会自动建 DNS 记录并签发证书
  "routes": [
    { "pattern": "sixdrop.dev", "custom_domain": true },
    { "pattern": "www.sixdrop.dev", "custom_domain": true }
  ]
}
