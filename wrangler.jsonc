{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sixdrop",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DROPS", "class_name": "Drop" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Drop"] }
  ],
  "observability": { "enabled": true },
  "workers_dev": true,

  // 自定义域名：zone 已激活，deploy 时会自动建 DNS 记录并签发证书
  "routes": [
    { "pattern": "sixdrop.dev", "custom_domain": true },
    { "pattern": "www.sixdrop.dev", "custom_domain": true }
  ]
}
